# Copy this to .env and fill in values for your chosen network.
# .env is gitignored; never commit secrets.

# Network: local | preprod | preview
MIDNIGHT_NETWORK=local

# Local devnet overrides (only used when MIDNIGHT_NETWORK=local)
MIDNIGHT_HOST=127.0.0.1
MIDNIGHT_NODE_PORT=9945
MIDNIGHT_INDEXER_PORT=8089
MIDNIGHT_PROOF_SERVER_PORT=6301

# Proof server URL (required for preprod/preview — run locally via Docker)
# MIDNIGHT_PROOF_SERVER=http://127.0.0.1:6301

# Wallet seed phrase (for CLI usage only — never expose in the UI)
MIDNIGHT_SEED=your_wallet_seed_phrase_here
